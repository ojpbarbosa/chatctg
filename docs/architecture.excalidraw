   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Blue boxes decide with probabilities. Grey boxes are deterministic code. White boxes are outside the service. Times are typical.",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Blue boxes decide with probabilities. Grey boxes are deterministic code. White boxes are outside the service. Times are typical.",
   "lineHeight": 1.25,
