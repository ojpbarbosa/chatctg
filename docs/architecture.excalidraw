   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Titler: an LLM, runs while the fetch runs,\ncapped at 4 s, template title as fallback\n\nWrites the title from the plan, never\nfrom the data, so it cannot invent a fact",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "title",
   "originalText": "Titler: an LLM, runs while the fetch runs,\ncapped at 4 s, template title as fallback\n\nWrites the title from the plan, never\nfrom the data, so it cannot invent a fact",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
