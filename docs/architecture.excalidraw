   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Judge: a System One model (Jev), one request, about 200 ms\n\nTwelve closed questions, each answered with a probability per option:\nintent (time trend, distribution, comparison, ranking,\ngeographic, network, count, lookup, other)\ndimension and secondary dimension (phase, status, sponsor,\ncountry, year, enrollment, drug, condition, ...)\nchart (14 types), chart named?, granularity, metric,\nedge kind, recruiting only?, combination?, phase filter",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "jev",
   "originalText": "Judge: a System One model (Jev), one request, about 200 ms\n\nTwelve closed questions, each answered with a probability per option:\nintent (time trend, distribution, comparison, ranking,\ngeographic, network, count, lookup, other)\ndimension and secondary dimension (phase, status, sponsor,\ncountry, year, enrollment, drug, condition, ...)\nchart (14 types), chart named?, granularity, metric,\nedge kind, recruiting only?, combination?, phase filter",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
  },
