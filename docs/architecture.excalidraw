  {
   "id": "agg_t",
   "type": "text",
   "x": 848,
   "y": 558,
   "width": 334,
   "height": 184,
   "angle": 0,
   "strokeColor": "#0b0b0c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 204234563,
   "version": 1,
   "versionNonce": 944425700,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Buckets: count once per value of the attribute,\ngap-fill years, top N, series by the second attribute\nPoints: one per trial\nGraph: nodes and weighted co-occurrence edges\nRows: the most recent trials\nValue: the registry's exact total\n\nStudies without a value are counted and stated.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "agg",
   "originalText": "Buckets: count once per value of the attribute,\ngap-fill years, top N, series by the second attribute\nPoints: one per trial\nGraph: nodes and weighted co-occurrence edges\nRows: the most recent trials\nValue: the registry's exact total\n\nStudies without a value are counted and stated.",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
  },
