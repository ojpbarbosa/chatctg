   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Extractor: an LLM under a strict JSON schema, about 800 ms\n\nReturns only strings copied from the question:\ndrugs, conditions, sponsors, countries,\nstart year, end year, limit\n\nIt never decides anything.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ext",
   "originalText": "Extractor: an LLM under a strict JSON schema, about 800 ms\n\nReturns only strings copied from the question:\ndrugs, conditions, sponsors, countries,\nstart year, end year, limit\n\nIt never decides anything.",
   "lineHeight": 1.25,
