   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Response, validated against the zod contract\n\nvisualization: type (bar, grouped bar, stacked bar, line,\nhistogram, scatter, network graph, map, table, single value,\nbubble, heatmap, timeline, sankey), title, subtitle,\nencoding (fields to axes, series, nodes, geo), data rows\n\nmeta: interpretation with probabilities, filters per arm,\nsource requests, coverage, timing per stage, notes, warnings",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "resp",
   "originalText": "Response, validated against the zod contract\n\nvisualization: type (bar, grouped bar, stacked bar, line,\nhistogram, scatter, network graph, map, table, single value,\nbubble, heatmap, timeline, sankey), title, subtitle,\nencoding (fields to axes, series, nodes, geo), data rows\n\nmeta: interpretation with probabilities, filters per arm,\nsource requests, coverage, timing per stage, notes, warnings",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
  },
