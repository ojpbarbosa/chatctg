  {
   "id": "cite_t",
   "type": "text",
   "x": 1218,
   "y": 558,
   "width": 324,
   "height": 184,
   "angle": 0,
   "strokeColor": "#0b0b0c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 32300934,
   "version": 1,
   "versionNonce": 835487537,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every data point cites up to five trials:\n{ nct_id, field, excerpt, title }\n\nfield is the registry path, for example\nprotocolSection.designModule.phases\nexcerpt is the exact value, for example PHASE3\n\nEdges cite trials where both ends co-occur.\nmeta.source lists every registry URL sent.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "cite",
   "originalText": "Every data point cites up to five trials:\n{ nct_id, field, excerpt, title }\n\nfield is the registry path, for example\nprotocolSection.designModule.phases\nexcerpt is the exact value, for example PHASE3\n\nEdges cite trials where both ends co-occur.\nmeta.source lists every registry URL sent.",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
  },
