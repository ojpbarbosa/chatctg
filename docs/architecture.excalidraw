   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Registry: ClinicalTrials.gov v2, /studies\n\nquery.intr, query.cond, query.spons, query.locn,\nfilter.overallStatus, filter.advanced (phase, years)\n19 fields, 1,000 per page, newest first,\ncapped at 3,000 trials, one-hour cache\n\nYearly trends over the cap: one exact count\nper year instead of a sample\nabout 0.8 s per 1,000 trials",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "fetch",
   "originalText": "Registry: ClinicalTrials.gov v2, /studies\n\nquery.intr, query.cond, query.spons, query.locn,\nfilter.overallStatus, filter.advanced (phase, years)\n19 fields, 1,000 per page, newest first,\ncapped at 3,000 trials, one-hour cache\n\nYearly trends over the cap: one exact count\nper year instead of a sample\nabout 0.8 s per 1,000 trials",
   "lineHeight": 1.25,
   "baseline": 11,
   "autoResize": true
