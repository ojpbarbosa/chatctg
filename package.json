{
  "name": "cheiron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "dev:web": "npm run dev --workspace @cheiron/web",
    "build": "npm run build --workspace @cheiron/web",
    "start": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval:jev": "tsx --env-file-if-exists=.env eval/run.ts",
    "eval:extract": "tsx --env-file-if-exists=.env eval/extract-bench.ts",
    "examples": "tsx --env-file-if-exists=.env examples/run.ts",
    "fixtures:record": "tsx packages/ctgov/scripts/record.ts"
  },
  "dependencies": { "tsx": "^4.19.0" },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
